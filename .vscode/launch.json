{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug codra (-m)",
      "type": "python",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "module": "codra.cli.main",
      "args": [
        "${workspaceFolder}/codra",
        "--threshold-csa", "5",
        "--threshold-id", "2",
        "--threshold-bps", "0.7",
        "--log-level", "DEBUG",
        "--output", "${workspaceFolder}/report.json"
      ],
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
